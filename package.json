{
  "name": "boppi",
  "version": "0.4.0",
  "description": "Local AI agent security scanner: discovers Claude Desktop, Claude Code, and Cursor MCP configurations, maps what your agents can reach, reports potential exposure paths, and verifies fixes. Scans run locally; boppi push can send the sanitized inventory to a Boppi workspace.",
  "author": "Melody Manzur",
  "bin": {
    "boppi": "bin/boppi.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Memanzur/boppi-scan.git"
  },
  "homepage": "https://github.com/Memanzur/boppi-scan#readme",
  "bugs": {
    "url": "https://github.com/Memanzur/boppi-scan/issues"
  },
  "keywords": [
    "mcp",
    "ai-security",
    "ai-agents",
    "claude",
    "cursor",
    "security-scanner",
    "attack-path"
  ],
  "scripts": {
    "test": "node test/run-all.js",
    "smoke": "node bin/boppi.js scan --help",
    "release-candidate": "node scripts/release-candidate.js",
    "verify-versions": "node scripts/verify-versions.js",
    "intelligence:demo": "node research/intelligence/demo.mjs",
    "verify:intelligence": "node --test research/intelligence/pipeline.test.mjs"
  }
}
